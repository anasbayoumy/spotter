{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.test",
    "tsconfig.base.json",
    "eslint.config.mjs",
    "vitest.config.ts"
  ],
  "globalEnv": [
    "ALLOW_NO_AUTH_SYNTHETIC_DEMO",
    "APP_ENV",
    "AI_MODE",
    "CRON_SECRET",
    "DATA_POLICY",
    "DATABASE_MODE",
    "DATABASE_URL",
    "DEMO_CLIENT_ID",
    "DEMO_COACH_ID",
    "PGLITE_DATA_DIR",
    "NEXT_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "demo": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**", ".expo/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/junit/unit.xml"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["reports/junit/integration.xml"]
    },
    "test:integration:pglite": {
      "dependsOn": ["^build"],
      "outputs": ["reports/junit/pglite.xml"]
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": ["reports/junit/contract.xml"]
    },
    "test:concurrency": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["reports/junit/concurrency.xml"]
    },
    "test:safety": {
      "dependsOn": ["^build"],
      "outputs": ["reports/junit/safety.xml", "reports/safety/**"]
    },
    "test:mutation": {
      "cache": false,
      "outputs": ["reports/mutation/**"]
    },
    "test:e2e:web": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:client": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:a11y": {
      "cache": false,
      "outputs": ["reports/accessibility/**"]
    },
    "test:mobile": {
      "cache": false,
      "outputs": ["reports/mobile/**", "dist/**"]
    },
    "test:performance": {
      "cache": false,
      "outputs": ["reports/performance/**"]
    },
    "test:resilience": {
      "cache": false,
      "outputs": ["reports/resilience/**"]
    },
    "test:security": {
      "cache": false,
      "outputs": ["reports/security/**"]
    },
    "coverage:changed": {
      "cache": false,
      "outputs": ["reports/coverage/changed/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
