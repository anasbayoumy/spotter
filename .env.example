# Runtime
APP_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Database: postgres is authoritative; pglite is demo/fast-test only
DATABASE_MODE=postgres
DATABASE_URL=postgresql://spotter_app:spotter_local_only@localhost:5432/spotter
PGLITE_DATA_DIR=.data/pglite
POSTGRES_ADMIN_PASSWORD=spotter_admin_local_only
POSTGRES_APP_PASSWORD=spotter_local_only
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Deterministic model mode is the default and requires no credentials
AI_MODE=recorded
AI_PROVIDER=
AI_GENERATOR_MODEL=
AI_JUDGE_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=

# Seeded, non-authenticated synthetic actors
DEMO_COACH_ID=00000000-0000-4000-8000-000000000001
DEMO_CLIENT_ID=00000000-0000-4000-8000-000000000101
DATA_POLICY=synthetic_only
ALLOW_NO_AUTH_SYNTHETIC_DEMO=true

# Public clients
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Infrastructure invocation only; not user authentication
CRON_SECRET=replace-for-non-demo-environments

# E2E
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_EXTERNAL_SERVER=
