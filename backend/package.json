{
  "name": "@spotter/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./database": "./src/infrastructure/database/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run src/domain",
    "test:integration:pglite": "vitest run tests/pglite",
    "test:integration": "vitest run tests/postgres",
    "test:concurrency": "vitest run tests/concurrency",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "demo": "tsx src/cli/demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@spotter/config": "workspace:*",
    "@spotter/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "4.0.8"
  }
}
