{
  "name": "@spotter/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run src",
    "test:contract": "vitest run tests/contract",
    "test:e2e:web": "playwright test --config tests/e2e/playwright.config.ts",
    "test:a11y": "playwright test --config tests/accessibility/playwright.config.ts",
    "test:resilience": "vitest run tests/resilience",
    "test:security": "vitest run tests/security",
    "coverage:changed": "vitest run src --coverage"
  },
  "dependencies": {
    "@spotter/backend": "workspace:*",
    "@spotter/config": "workspace:*",
    "@spotter/contracts": "workspace:*",
    "@spotter/design-tokens": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "29.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "4.0.8"
  }
}
