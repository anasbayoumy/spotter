{
  "name": "spotter-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Human-supervised AI coaching system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "preinstall": "node scripts/assert-toolchain.mjs",
    "dev": "turbo run dev --parallel",
    "demo": "node scripts/run-mode.mjs demo",
    "build": "turbo run build",
    "clean": "turbo run clean && node scripts/clean-root.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:eslint && pnpm lint:forbidden && pnpm lint:boundaries",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:forbidden": "node scripts/check-forbidden-patterns.mjs",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "boundaries:check": "pnpm lint:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit -- --coverage",
    "test:integration": "node scripts/docker/with-test-postgres.mjs test:integration",
    "test:integration:pglite": "turbo run test:integration:pglite",
    "test:contract": "turbo run test:contract",
    "test:contracts": "pnpm test:contract",
    "test:concurrency": "node scripts/docker/with-test-postgres.mjs test:concurrency",
    "test:safety": "turbo run test:safety",
    "test:mutation": "turbo run test:mutation",
    "test:e2e:web": "turbo run test:e2e:web",
    "test:e2e:client": "turbo run test:e2e:client",
    "test:e2e:mobile": "pnpm test:e2e:client",
    "test:a11y": "turbo run test:a11y",
    "test:mobile": "turbo run test:mobile",
    "test:performance": "turbo run test:performance",
    "test:resilience": "turbo run test:resilience",
    "test:security": "node scripts/security/run-security-suite.mjs",
    "test:docker": "node scripts/docker/verify.mjs",
    "verify:docker": "pnpm test:docker",
    "verify:generated": "node scripts/verification/verify-generated.mjs",
    "coverage:changed": "turbo run coverage:changed",
    "evidence:verify": "node scripts/verification/verify-evidence.mjs",
    "verify": "node scripts/verification/run-suite.mjs fast",
    "verify:full": "node scripts/verification/run-suite.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@stryker-mutator/core": "9.2.0",
    "@stryker-mutator/typescript-checker": "9.2.0",
    "@stryker-mutator/vitest-runner": "9.2.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.8",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prettier": "3.7.3",
    "turbo": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.8"
  }
}
