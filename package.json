{
  "name": "spotter-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Human-supervised AI coaching system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "preinstall": "node backend/tooling/assert-toolchain.mjs",
    "install:frozen": "pnpm install --frozen-lockfile",
    "dev": "turbo run dev --parallel",
    "demo": "node backend/tooling/run-mode.mjs demo",
    "build": "turbo run build",
    "clean": "turbo run clean && node backend/tooling/clean-root.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:eslint && pnpm lint:forbidden && pnpm lint:boundaries",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:forbidden": "node backend/tooling/check-forbidden-patterns.mjs",
    "lint:boundaries": "node backend/tooling/check-boundaries.mjs",
    "boundaries:check": "pnpm lint:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit -- --coverage && node --test backend/tooling/verification/*.test.mjs",
    "test:integration": "node backend/tooling/docker/with-test-postgres.mjs test:integration",
    "test:integration:pglite": "turbo run test:integration:pglite",
    "test:contract": "turbo run test:contract",
    "test:contracts": "pnpm test:contract",
    "test:concurrency": "node backend/tooling/docker/with-test-postgres.mjs test:concurrency",
    "test:safety": "turbo run test:safety",
    "test:mutation": "turbo run test:mutation",
    "test:e2e:web": "turbo run test:e2e:web",
    "test:e2e:client": "turbo run test:e2e:client",
    "test:e2e:mobile": "pnpm test:e2e:client",
    "test:a11y": "turbo run test:a11y",
    "test:mobile": "turbo run test:mobile",
    "test:performance": "node --test backend/tooling/performance/*.test.mjs && node backend/tooling/performance/run.mjs",
    "test:resilience": "turbo run test:resilience",
    "test:security": "node backend/tooling/security/run-security-suite.mjs",
    "test:docker": "node backend/tooling/docker/verify.mjs",
    "verify:docker": "pnpm test:docker",
    "generate:openapi": "node backend/tooling/verification/generate-openapi.mjs",
    "verify:generated": "node backend/tooling/verification/verify-generated.mjs",
    "coverage:changed": "node backend/tooling/verification/run-coverage.mjs",
    "evidence:verify": "node backend/tooling/verification/verify-evidence.mjs",
    "verify": "node backend/tooling/verification/run-suite.mjs fast",
    "verify:full": "node backend/tooling/verification/run-suite.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@stryker-mutator/core": "9.2.0",
    "@stryker-mutator/typescript-checker": "9.2.0",
    "@stryker-mutator/vitest-runner": "9.2.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.0.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.8"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils>undici": "6.28.0",
      "next>postcss": "8.5.25",
      "next>sharp": "0.35.3"
    }
  }
}
